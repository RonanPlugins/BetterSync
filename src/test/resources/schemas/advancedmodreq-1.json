{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ronanplugins.com/advancedmodreq/1",
  "title": "AdvancedModreq editor configuration",
  "type": "object",
  "required": [
    "Settings",
    "Notifications",
    "Economy",
    "Alias",
    "Category",
    "Template",
    "DefaultListFilters"
  ],
  "properties": {
    "Settings": {
      "type": "object",
      "properties": {
        "MinimumWords": {
          "minimum": 0
        },
        "MessageCutOff": {
          "type": "object",
          "properties": {
            "Max": {
              "minimum": 0
            }
          }
        },
        "Message-Delay": {
          "minimum": 0
        },
        "Cooldown": {
          "type": "object",
          "properties": {
            "Time": {
              "minimum": 0
            }
          }
        }
      }
    },
    "Notifications": {
      "type": "object"
    },
    "Economy": {
      "type": "object",
      "properties": {
        "Price": {
          "minimum": 0
        }
      }
    },
    "Alias": {
      "type": "object",
      "properties": {
        "List": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          }
        }
      }
    },
    "Category": {
      "type": "object",
      "properties": {
        "Categories": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "Description": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 1000,
                  "default": []
                },
                "Importance": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5,
                  "default": 0
                },
                "Item": {
                  "type": "string",
                  "default": "bedrock",
                  "x-serverCheck": "item",
                  "x-checkChanged": true
                }
              },
              "x-editableProperties": true
            }
          },
          "x-named": true,
          "x-editor": {
            "collection": "categories"
          }
        }
      }
    },
    "Template": {
      "type": "object",
      "properties": {
        "Templates": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "Message": {
                  "type": "string",
                  "default": ""
                },
                "Importance": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5,
                  "default": 0
                },
                "Item": {
                  "type": "string",
                  "default": "bedrock",
                  "x-serverCheck": "item",
                  "x-checkChanged": true
                },
                "Name": {
                  "type": "string",
                  "default": ""
                },
                "Lore": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "Category": {
                  "type": "string",
                  "default": ""
                }
              },
              "x-editableProperties": true
            }
          },
          "x-named": true,
          "x-editor": {
            "collection": "templates"
          }
        }
      }
    },
    "Language-File": {
      "type": "string",
      "x-immutable": true,
      "description": "Change the language file locally."
    },
    "DefaultListFilters": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "Resolved": {
            "type": "boolean",
            "default": false
          },
          "Flagged": {
            "type": "boolean",
            "default": false
          },
          "Claimed": {
            "type": "boolean",
            "default": false
          },
          "Opened": {
            "type": "boolean",
            "default": true
          },
          "Closed": {
            "type": "boolean",
            "default": false
          },
          "Rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "Importance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "Category": {
            "type": "string",
            "default": ""
          }
        }
      },
      "x-named": true,
      "x-editor": {
        "collection": "filters"
      },
      "x-caseInsensitiveKeys": true
    }
  },
  "x-bettersync": {
    "format": 1,
    "plugin": "advancedmodreq",
    "schemaVersion": "1",
    "displayName": "AdvancedModreq"
  },
  "x-rules": [
    {
      "path": "config\\.Notifications\\..*\\.Sound",
      "schema": {
        "x-serverCheck": "sound",
        "x-checkChanged": true,
        "x-allow": [
          "null"
        ]
      }
    }
  ]
}
